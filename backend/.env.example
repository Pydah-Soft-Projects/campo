# PORT=8000
# MONGODB_URI=mongodb://127.0.0.1:27017/campo
# JWT_SECRET=your_jwt_secret_key_here
# ADMIN_EMAIL=admin@campo.co.in
# ADMIN_PASSWORD=admin
# ADMIN_NAME=Campo Super Admin
# CORS_ORIGIN=*

# # ==========================================
# # WHATSAPP TEMPLATE MESSAGING API (WAPost / Meta Cloud API)
# # ==========================================
# # Base API URL (defaults to https://api.wapost.click/api/meta/v19.0)
# WHATSAPP_API_URL=https://api.wapost.click/api/meta/v19.0

# # Your WhatsApp Business Phone Number ID (provided by WAPost / Meta)
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# # Bearer Access Token (provided by WAPost admin - Permanent or Demo token)
# WHATSAPP_ACCESS_TOKEN=your_bearer_access_token_here

# # Approved Template Name in your WAPost dashboard
# WHATSAPP_TEMPLATE_NAME=your_approved_template_name

# # Template Language code (defaults to en)
# WHATSAPP_TEMPLATE_LANG=en

# # (Optional) Number of body variables expected by your template (e.g. 2, 3, 4, 5)
# # WHATSAPP_TEMPLATE_VAR_COUNT=5

# # (Optional) Header media URL if your template includes an Image or Document Header
# # WHATSAPP_HEADER_TYPE=image
# # WHATSAPP_HEADER_MEDIA_URL=https://campo.co.in/og-image.png
